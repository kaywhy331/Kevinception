{
  "name": "kevinception",
  "version": "0.9.0",
  "private": true,
  "description": "Kevinception — an accessible six-era portfolio with immersive and direct paths, canonical case studies, and production hardening.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "preview": "node scripts/serve.mjs out 4321",
    "start": "npm run preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:css": "stylelint \"app/**/*.css\" \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:legacy-js": "node scripts/check-legacy-js.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:legacy-data": "node scripts/sync-era-world-data.mjs --check",
    "check:build": "node scripts/check-build.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:diff": "git diff --check",
    "smoke:headers": "node scripts/smoke-headers.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:legacy-js && npm run check:content && npm run check:legacy-data && npm run build && npm run check:build && npm run check:bundle && npm run check:links && npm run check:security",
    "sync:legacy-data": "node scripts/sync-era-world-data.mjs",
    "test:runtime": "node scripts/runtime-check.mjs",
    "test:runtime:chapters": "node scripts/runtime-commerce-coexistence.mjs",
    "test:runtime:future": "node scripts/runtime-future-native.mjs",
    "test:runtime:review": "node scripts/runtime-review-v77.mjs",
    "test:runtime:ultrawide": "node scripts/capture-future-ultrawide.mjs",
    "test:runtime:all": "node scripts/runtime-all.mjs",
    "doctor": "node scripts/doctor.mjs",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "verify:full": "npm run doctor && npm run verify && npm run audit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "@xstate/react": "6.1.0",
    "gsap": "3.15.0",
    "next": "16.3.6",
    "postprocessing": "6.39.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1",
    "xstate": "5.32.5",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "27.2.0",
    "prettier": "3.9.9",
    "puppeteer-core": "25.3.0",
    "stylelint": "17.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.10"
  }
}
