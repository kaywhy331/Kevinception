    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "jsdom": "27.2.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
